# Docker Compose single-host profile only. Kubernetes uses deploy/k8s ConfigMap
# plus the externally managed consflow-runtime-secrets Secret; do not reuse this
# file as a Kubernetes secret generator.
#
# Copy to .env.prod outside source control. Secret values belong in the referenced
# readonly bind-mount source files protected by a mode-0700 parent directory,
# never in this environment file.
COMPOSE_PROJECT_NAME=consflow-prod

# Release workflow injects digest-pinned references at deploy time. These tag
# examples are only for local Compose validation and must match RELEASE_TAG.
RELEASE_TAG=v2026-08-20.1
BACKEND_IMAGE=ghcr.io/replace-owner/replace-repository-backend:v2026-08-20.1
ADMIN_IMAGE=ghcr.io/replace-owner/replace-repository-admin:v2026-08-20.1

# Direct Caddy Automatic HTTPS. DNS A for this hostname must point to the VPS,
# and inbound TCP 80/443 must be open before the first certificate request.
APP_DOMAIN=tt-dnh.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
FRONTEND_ORIGIN=https://tt-dnh.com

# Direct Internet clients are not trusted proxies. If a managed edge is added
# later, replace this with only the immediate proxy/load-balancer CIDR.
TRUSTED_PROXY_CIDR=127.0.0.1/32
REAL_IP_HEADER=X-Forwarded-For

# Choose a private subnet that does not overlap the host/VPC networks. The backend
# trusts only this Docker subnet because Caddy is its sole HTTP peer in production.
APP_INTERNAL_SUBNET=172.30.0.0/24

POSTGRES_DB=consflow
POSTGRES_USER=consflow
# Keep the parent directory mode 0700 on the host. Compose file-source secrets
# are readonly bind mounts, so use mode 0644 on these files for container UIDs.
POSTGRES_PASSWORD_FILE=./.env.prod.secrets/postgres_password
DATABASE_URL_FILE=./.env.prod.secrets/database_url
REDIS_PASSWORD_FILE=./.env.prod.secrets/redis_password
REDIS_URL_FILE=./.env.prod.secrets/redis_url
REDIS_CACHE_PASSWORD_FILE=./.env.prod.secrets/redis_cache_password
REDIS_CACHE_URL_FILE=./.env.prod.secrets/redis_cache_url
JWT_SECRET_FILE=./.env.prod.secrets/jwt_secret
SETTINGS_ENCRYPTION_KEY_FILE=./.env.prod.secrets/settings_encryption_key
# Keep /dev/null while account recovery is disabled or the SMTP relay uses no
# authentication. Point to a protected file when SMTP_USERNAME is configured.
SMTP_PASSWORD_FILE=/dev/null
AWS_CREDENTIALS_FILE=./.env.prod.secrets/aws_credentials

# First deploy: point this at a protected file containing the initial Admin
# password. After a successful bootstrap, replace it with /dev/null; later runs
# detect the same active Admin and do not read or reset the password.
BOOTSTRAP_ADMIN_EMAIL=admin@tt-dnh.com
BOOTSTRAP_ADMIN_FULL_NAME=Quản trị hệ thống
BOOTSTRAP_ADMIN_DEPARTMENT=Công nghệ
BOOTSTRAP_ADMIN_POSITION=Admin
BOOTSTRAP_ADMIN_PASSWORD_FILE=/dev/null

# Production migration is a one-shot Compose dependency. Backend startup must
# never race schema changes across replicas.
AUTO_MIGRATE=false
MIGRATION_LOCK_TIMEOUT=30s
MIGRATION_TIMEOUT=5m

# Production runtime storage is S3-only. Leave endpoint empty for AWS S3; set
# an HTTPS endpoint plus path-style mode when required by an S3-compatible host.
STORAGE_PROVIDER=s3
STORAGE_OPERATION_TIMEOUT=30s
STORAGE_S3_BUCKET=tt-dnh-consflow-prod
# Copy the exact region identifier shown in the Vietnix portal.
STORAGE_S3_REGION=replace-with-vietnix-region
STORAGE_S3_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
STORAGE_S3_USE_PATH_STYLE=false
STORAGE_S3_ALLOW_INSECURE_ENDPOINT=false
AWS_PROFILE=default

MAX_UPLOAD_BYTES=10485760
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_HOURS=168
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_RECOVERY_ENABLED=false
AUTH_RECOVERY_TOKEN_TTL=15m
AUTH_RECOVERY_VERIFY_TTL=24h
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Consflow
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
READINESS_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
REDIS_OPERATION_TIMEOUT=250ms

# Roll out in order: off -> shadow -> serve. Cache Redis is disposable and
# intentionally separate from rate limiting and SSE Pub/Sub.
PROJECT_EXPLORER_CACHE_MODE=off
PROJECT_EXPLORER_CACHE_TIMEOUT=200ms
PROJECT_EXPLORER_CACHE_INDEX_TTL=5m
PROJECT_EXPLORER_CACHE_ROW_TTL=10m
PROJECT_EXPLORER_CACHE_LOCK_TTL=2s
PROJECT_EXPLORER_CACHE_MAX_VALUE_BYTES=262144

# Standard Caddy does not bundle a request-rate limiter. Production therefore
# keeps the backend distributed IP/actor limiter enforced. A managed edge/WAF
# remains the recommended later hardening layer for volumetric and bot traffic.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MODE=enforce
RATE_LIMIT_REDIS_MAX_IN_FLIGHT=32
RATE_LIMIT_LOCAL_MAX_KEYS=10000
RATE_LIMIT_IP_AUTH_LIMIT=10
RATE_LIMIT_IP_AUTH_BURST=10
RATE_LIMIT_IP_AUTH_WINDOW=1m
RATE_LIMIT_IP_GENERAL_LIMIT=300
RATE_LIMIT_IP_GENERAL_BURST=60
RATE_LIMIT_IP_GENERAL_WINDOW=1m
RATE_LIMIT_IP_UPLOAD_LIMIT=20
RATE_LIMIT_IP_UPLOAD_BURST=5
RATE_LIMIT_IP_UPLOAD_WINDOW=1m
RATE_LIMIT_IP_EXPORT_LIMIT=30
RATE_LIMIT_IP_EXPORT_BURST=5
RATE_LIMIT_IP_EXPORT_WINDOW=1m
RATE_LIMIT_IP_SSE_LIMIT=30
RATE_LIMIT_IP_SSE_BURST=5
RATE_LIMIT_IP_SSE_WINDOW=1m
RATE_LIMIT_ACTOR_AUTH_LIMIT=30
RATE_LIMIT_ACTOR_AUTH_BURST=10
RATE_LIMIT_ACTOR_AUTH_WINDOW=1m
RATE_LIMIT_ACTOR_GENERAL_LIMIT=600
RATE_LIMIT_ACTOR_GENERAL_BURST=120
RATE_LIMIT_ACTOR_GENERAL_WINDOW=1m
RATE_LIMIT_ACTOR_UPLOAD_LIMIT=30
RATE_LIMIT_ACTOR_UPLOAD_BURST=5
RATE_LIMIT_ACTOR_UPLOAD_WINDOW=1m
RATE_LIMIT_ACTOR_EXPORT_LIMIT=60
RATE_LIMIT_ACTOR_EXPORT_BURST=10
RATE_LIMIT_ACTOR_EXPORT_WINDOW=1m
RATE_LIMIT_ACTOR_SSE_LIMIT=20
RATE_LIMIT_ACTOR_SSE_BURST=4
RATE_LIMIT_ACTOR_SSE_WINDOW=1m
UPLOAD_CONCURRENCY=4
EXPORT_CONCURRENCY=4
REPORT_CONCURRENCY=6
SSE_MAX_CONNECTIONS=300
SSE_MAX_CONNECTIONS_PER_IP=20
SSE_MAX_CONNECTIONS_PER_ACTOR=2
SSE_VISIBILITY_TIMEOUT=2s
SSE_MAX_CONNECTION_LIFETIME=5m
SSE_BROKER_CHANNEL=consflow:activity:v1

LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
POSTGRES_SHM_SIZE=256m
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.5
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5
REDIS_CACHE_MAXMEMORY=192mb
REDIS_CACHE_MEMORY_LIMIT=256m
REDIS_CACHE_CPU_LIMIT=0.5
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=2.0
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_CPU_LIMIT=0.5
BOOTSTRAP_ADMIN_MEMORY_LIMIT=128m
BOOTSTRAP_ADMIN_CPU_LIMIT=0.25
ADMIN_MEMORY_LIMIT=256m
ADMIN_CPU_LIMIT=1.0
