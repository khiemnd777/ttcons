# Canonical local production operator input.
#
# Copy/bootstrap this file as deploy/config/production.env. The real file and
# generated SSH material are Git-ignored and must stay mode 0600. GitHub receives
# only VPS deploy transport secrets; application/runtime secrets are provisioned
# directly to /opt/consflow/shared on the VPS.

GITHUB_REPOSITORY=khiemnd777/ttcons
GITHUB_ENVIRONMENT=production

VPS_HOST=160.30.113.13
VPS_PORT=22
VPS_USER=root
VPS_DEPLOY_ROOT=/opt/consflow
VPS_HOST_KEY_FINGERPRINT=REPLACE_WITH_VERIFIED_VPS_ED25519_FINGERPRINT

APP_DOMAIN=tt-dnh.com
BOOTSTRAP_ADMIN_EMAIL=admin@tt-dnh.com
BOOTSTRAP_ADMIN_FULL_NAME=Quản trị hệ thống
BOOTSTRAP_ADMIN_DEPARTMENT=Công nghệ
BOOTSTRAP_ADMIN_POSITION=Admin

# `make production-bootstrap` replaces GENERATE values using openssl rand and
# never overwrites an already populated value.
POSTGRES_PASSWORD=GENERATE
REDIS_PASSWORD=GENERATE
REDIS_CACHE_PASSWORD=GENERATE
JWT_SECRET=GENERATE
SETTINGS_ENCRYPTION_KEY=GENERATE
BOOTSTRAP_ADMIN_PASSWORD=GENERATE

STORAGE_S3_BUCKET=tt-dnh-consflow-prod
STORAGE_S3_REGION=vn-hcm-1
STORAGE_S3_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
STORAGE_S3_USE_PATH_STYLE=false
S3_ACCESS_KEY=REPLACE_WITH_VIETNIX_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_VIETNIX_SECRET_KEY
