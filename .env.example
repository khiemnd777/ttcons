# Copy this file to .env before starting the local stack. .env is ignored by Git.
COMPOSE_PROJECT_NAME=ttcons
APP_ENV=development

# Replace with the output of `id -u` and `id -g` on the development host.
LOCAL_UID=1000
LOCAL_GID=1000

# Local service bindings.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_BIND_ADDRESS=127.0.0.1
REDIS_CACHE_PORT=6380
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=5173

# Local database and cache. Host URLs are used by backend/Makefile; Compose URLs
# use Docker service DNS names.
POSTGRES_DB=consflow
POSTGRES_USER=consflow
POSTGRES_PASSWORD=consflow
DATABASE_URL=postgres://consflow:consflow@127.0.0.1:5432/consflow?sslmode=disable
COMPOSE_DATABASE_URL=postgres://consflow:consflow@postgres:5432/consflow?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
COMPOSE_REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6380/0
COMPOSE_REDIS_CACHE_URL=redis://redis-cache:6379/0

# Local application runtime.
PORT=8080
JWT_SECRET=replace-with-a-local-development-secret
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api
# Account recovery is opt-in. For local SMTP testing, enable it and configure
# a development mail catcher or another reviewed SMTP relay.
AUTH_RECOVERY_ENABLED=false
AUTH_RECOVERY_TOKEN_TTL=15m
AUTH_RECOVERY_VERIFY_TTL=24h
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Consflow
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s
MIGRATIONS_DIR=migrations
AUTO_MIGRATE=true
MAX_UPLOAD_BYTES=10485760
PROJECT_EXPLORER_CACHE_MODE=serve
PROJECT_EXPLORER_CACHE_TIMEOUT=200ms
PROJECT_EXPLORER_CACHE_INDEX_TTL=5m
PROJECT_EXPLORER_CACHE_ROW_TTL=10m
PROJECT_EXPLORER_CACHE_LOCK_TTL=2s
PROJECT_EXPLORER_CACHE_MAX_VALUE_BYTES=262144

# Use an absolute host path ending in this repository's storage directory.
# Docker bind-mounts it at /storage; it must not point inside a container.
STORAGE_PROVIDER=default
STORAGE_PATH=/absolute/path/to/ttcons/storage
STORAGE_OPERATION_TIMEOUT=30s

# S3 settings are ignored while STORAGE_PROVIDER=default. Configure them and set
# STORAGE_PROVIDER=s3 to exercise the S3-only runtime path.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_USE_PATH_STYLE=false
STORAGE_S3_ALLOW_INSECURE_ENDPOINT=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
